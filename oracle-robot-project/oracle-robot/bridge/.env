# ---- copy to .env and fill in ------------------------------------------------
# The only key you need. It is used for ONE thing: answering questions that are not in the script (text in, text out).
# Speech-to-text (faster-whisper) and text-to-speech (Piper) run locally on the laptop: no key, no cost, no audio uploaded.
DEEPSEEK_API_KEY=sk-586da6d7805643168e024330829c5599

# DeepSeek model for unscripted questions (OpenAI-compatible API at https://api.deepseek.com).
# "deepseek-flash" is the cheap, fast one; "deepseek-v4-pro" is the stronger, dearer one. Names change: check
# https://api-docs.deepseek.com/quick_start/pricing. The bridge always turns DeepSeek's thinking mode OFF (it is on by
# default, and far too slow for a kiosk).
DEEPSEEK_MODEL=deepseek-flash

# Speech-to-text (local faster-whisper). Model size: tiny.en / base.en / small.en / medium.en (multilingual: small, medium).
# Downloaded automatically on first run (~460 MB for small.en) and cached; loaded in the background at startup.
LOCAL_STT_MODEL=small.en
STT_LANGUAGE=en          # leave empty to auto-detect Hindi/Marathi (needs a multilingual model, e.g. LOCAL_STT_MODEL=small; scripted answers stay English)

# Text-to-speech (local). piper = natural, offline; pyttsx3 = system voice (Windows SAPI / macOS / espeak), used
# automatically with a warning if Piper or its voice file is missing.
# Download a Piper voice (BOTH the .onnx and the .onnx.json) from https://huggingface.co/rhasspy/piper-voices
# e.g. en/en_US/lessac/medium/en_US-lessac-medium.onnx  and  ...onnx.json  -> put them in bridge/voices/
TTS_ENGINE=piper
PIPER_VOICE=voices/en_US-lessac-medium.onnx
# Scripted answers are rendered once by --prebuild into bridge/cache/. Changing the engine or voice invalidates that
# cache and the robot's stored clips: re-run --prebuild, and the robot swaps its clips on the next connect.

# Tuning
USE_CLIPS=1             # store scripted answers in the ESP32's flash (ADPCM) so they play instantly and offline
NOISE_FILTER=1          # high-pass + spectral noise gate + silence trim on the laptop (0 = off)
SCRIPT_FIRST=1          # 1 = keyword answers first, DeepSeek for the rest; 0 = everything goes to DeepSeek
MIN_RMS=80               # recordings quieter than this are treated as silence (calibrate with serial command 'm')
MOVE_SPEED_PCT=55
MOVE_FWD_MS=800
MOVE_BACK_MS=600
MOVE_TURN_MS=450
BRIDGE_PORT=8765
LOG_LEVEL=INFO
